<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GuitarBridge</AssemblyName>
    <Version>0.1.1</Version>
    <Product>Guitar Bridge</Product>
    <Company>GuitarBridge</Company>
    <Description>Low-latency ASIO monitoring through a Windows speaker output.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>assets\GuitarBridge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;dist\**;tests\**;artifacts\**;driver-trial-*\**;installer\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="LICENSE" LogicalName="GuitarBridge.LICENSE" />
    <EmbeddedResource Include="licenses\*.txt" />
  </ItemGroup>
</Project>
