<Window x:Class="GuitarBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="Guitar Bridge" Width="720" Height="540" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Background="#141218" Foreground="#E6E0E9" FontFamily="Segoe UI" TextElement.FontSize="14">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#211F26"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="18"/></Style>
 </Window.Resources>
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20">
 <Grid Width="680" Height="500">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="80"/><RowDefinition Height="260"/><RowDefinition Height="100"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Guitar Bridge" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" MouseLeftButtonDown="Title_Drag" ToolTip="Drag to move"/>
   <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="Refresh_Click" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Refresh audio devices" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" AutomationProperties.Name="Setup and latency tips" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="120000">
    <md:PackIcon Kind="InformationOutline" Width="24" Height="24"/>
    <Button.ToolTip><ToolTip MaxWidth="430" Padding="16"><TextBlock TextWrapping="Wrap" Text="Enable the required inputs in your ASIO control panel. Scan channels and select the input you want to monitor. Keep the selected output device available to Windows.&#10;&#10;Try 128 samples in the ASIO panel and a 10 ms output target first. Lower to 64 samples / 5 ms if stable. If audio crackles, increase the buffers. Actual latency depends on the drivers; the displayed queue time is not an end-to-end measurement.&#10;&#10;Closing this window keeps audio running. Use the tray menu to stop or quit. Windows controls whether the icon appears inside the overflow arrow. A saved route can start automatically on later launches."/></ToolTip></Button.ToolTip>
   </Button>
   <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}" Click="Hide_Click" AutomationProperties.Name="Close to tray" ToolTip="Close to tray" Margin="4,0,0,0">
    <md:PackIcon Kind="Close" Width="22" Height="22"/>
   </Button>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Background="#30283F" Padding="18,10" Margin="0,0,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="StatusLabel" Text="Routing off" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock x:Name="StatusDetail" Text="Select an audio input and output device." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="#CAC4D0" FontSize="12" Margin="0,4,16,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
    <Button x:Name="WarningButton" Grid.Column="1" Visibility="Collapsed" Click="Warning_Click" Margin="0,0,12,0" Style="{StaticResource MaterialDesignIconButton}" Foreground="#FFD8A8" AutomationProperties.Name="Show full attention message" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="120000">
     <md:PackIcon Kind="AlertOutline" Width="24" Height="24"/>
     <Button.ToolTip><ToolTip Padding="16" MaxWidth="430"><TextBlock x:Name="WarningTipText" Width="390" TextWrapping="Wrap"/></ToolTip></Button.ToolTip>
    </Button>
    <Popup x:Name="WarningPopup" PlacementTarget="{Binding ElementName=WarningButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
     <Border Background="#30283F" BorderBrush="#776A88" BorderThickness="1" CornerRadius="16" Padding="18" Margin="6">
      <StackPanel Width="390"><TextBlock Text="Needs attention" Foreground="#FFD8A8" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
       <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="WarningPopupText" TextWrapping="Wrap" Foreground="#E6E0E9"/></ScrollViewer>
      </StackPanel>
     </Border>
    </Popup>
    <ToggleButton x:Name="RouteButton" Grid.Column="2" Click="Route_Click" Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Audio routing on or off" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Grid x:Name="RouteSettings" Grid.Row="2" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="INPUT" Foreground="#D0BCFF" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ComboBox x:Name="Drivers" md:HintAssist.Hint="ASIO driver" Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectionChanged="Driver_Changed"/>
    <ComboBox x:Name="Channels" Margin="0,12,0,0" md:HintAssist.Hint="First input channel" Style="{StaticResource MaterialDesignOutlinedComboBox}" DisplayMemberPath="Name" SelectedValuePath="Index"/>
    <CheckBox x:Name="Stereo" Content="Stereo pair" IsChecked="True" Margin="0,10,0,4" ToolTip="Off: copy one mono input to both output channels. On: use this channel and the next."/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Content="ASIO panel" Style="{StaticResource MaterialDesignFlatButton}" Click="Panel_Click" Padding="8,0"/>
     <Button Grid.Column="1" Content="Scan channels" Style="{StaticResource MaterialDesignFlatButton}" Click="Scan_Click" Padding="8,0"/>
    </Grid>
   </StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="OUTPUT" Foreground="#D0BCFF" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ComboBox x:Name="Outputs" md:HintAssist.Hint="Output device" Style="{StaticResource MaterialDesignOutlinedComboBox}" DisplayMemberPath="Name" SelectedValuePath="Id"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ComboBox x:Name="Rates" md:HintAssist.Hint="Rate (Hz)" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
     <ComboBox x:Name="Buffers" Grid.Column="2" md:HintAssist.Hint="Buffer (ms)" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
    </Grid>
    <CheckBox x:Name="Exclusive" Content="Exclusive output" IsChecked="False" Margin="0,10,0,4" ToolTip="Leave off to hear guitar alongside YouTube and other apps. On: reserves the speakers for guitar routing only."/>
    <TextBlock Text="Hover over ⓘ for setup and latency tips." Foreground="#CAC4D0" FontSize="12" Margin="0,8,0,0"/>
   </StackPanel></Border>
  </Grid>
  <StackPanel Grid.Row="3">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <TextBlock Text="Output level" VerticalAlignment="Center"/>
    <Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="200" Value="50" Margin="18,0" ValueChanged="Volume_Changed" ToolTip="Up to 100%: normal level. Above 100%: boost quiet signals, up to +6 dB. A peak limiter reduces gain when needed to avoid digital clipping."/>
    <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="50%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </Grid>
   <ProgressBar x:Name="Meter" Minimum="0" Maximum="1" Height="3" Foreground="#D0BCFF" Margin="0,10,0,5"/>
   <TextBlock x:Name="Stats" Text="Input level · waiting for audio" FontSize="11" Foreground="#CAC4D0"/>
   <CheckBox x:Name="AutoStart" Content="Start routing when I launch the app" Margin="0,10,0,0"/>
  </StackPanel>
 </Grid>
 </Viewbox>
</Window>

